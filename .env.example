# Copy to .env and adjust. Real environment variables override this file.

# ---- Security (CHANGE THESE outside a demo) --------------------------------
# Leave JWT_SECRET empty to auto-generate one into data/.jwt_secret
JWT_SECRET=
TOKEN_TTL_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin#2026!
USER_USERNAME=analyst
USER_PASSWORD=Analyst#2026!
MAX_UPLOAD_MB=15
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- Language model ---------------------------------------------------------
# mock      = offline: deterministic extractive answers, no API key needed
# openai    = OpenAI or any OpenAI-compatible endpoint (Azure, vLLM, LM Studio...)
# anthropic = Claude API
# ollama    = local models via Ollama
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# ---- Retrieval --------------------------------------------------------------
TOP_K=6
# Share of the question's specific terms that must be found in the evidence
MIN_EVIDENCE_COVERAGE=0.6

# ---- Automation -------------------------------------------------------------
# Without SMTP_HOST, notification emails are written to data/outbox/*.eml
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=advisor@example.com
SMTP_STARTTLS=true
NOTIFY_TO=ops@example.com
# Slack / Teams incoming webhook, n8n, Zapier, Make... (optional)
WEBHOOK_URL=
AUTOMATION_MAX_ATTEMPTS=3

# ---- Server -----------------------------------------------------------------
DATA_DIR=data
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
